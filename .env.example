# Copie para .env (docker compose lê automaticamente). Nunca versione o .env.

# Senha do PostgreSQL. Vai dentro de uma URL: evite @ : / ? # ou codifique-os.
POSTGRES_PASSWORD=troque-esta-senha

# Chave compartilhada com o agente (>= 16 caracteres). A MESMA do build.sh.
RELAY_AGENT_KEY=troque-esta-chave-0123456789
# Agentes antigos (só a chave, sem cadastro): "true" aceita enquanto as máquinas
# não são reinstaladas (aparecem só para administradores); "false" recusa.
RELAY_LEGACY_AGENTS=true

# Admin inicial: criado só se o banco não tiver nenhum usuário.
RELAY_ADMIN_USER=admin
RELAY_ADMIN_PASS=troque-esta-senha-do-admin

# Onde o relay escuta no host. 127.0.0.1 = só a máquina local (túnel/proxy).
RELAY_BIND=127.0.0.1
RELAY_PORT=8080

# IP real do técnico na auditoria, vindo do túnel/proxy. Atrás do Cloudflare
# Tunnel: Cf-Connecting-IP. Deixe vazio se o relay for acessível sem o túnel.
RELAY_CLIENT_IP_HEADER=

# Cadastro e recuperação por e-mail. Sem SMTP_HOST ficam desligados.
# RELAY_PUBLIC_URL é a base dos links dos e-mails.
RELAY_PUBLIC_URL=
# RELAY_LOCAL_URL: como alcançar o relay sem a internet, no PC onde ele roda
# (ex.: http://localhost:8080). O visualizador do técnico usa sozinho quando
# chega nele: o vídeo não dá a volta pelo túnel. Vazio desliga.
RELAY_LOCAL_URL=
# Quem confirmar esta caixa no cadastro vira admin sem precisar de aprovação.
# Com ela, RELAY_ADMIN_PASS pode ficar vazio num banco novo.
RELAY_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Precisa estar verificado no provedor.
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=RemoteIT

# Só com --profile tunnel.
TUNNEL_TOKEN=
